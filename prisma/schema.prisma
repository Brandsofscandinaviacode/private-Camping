// CampSense - Camping Site Management Platform
// Database: SQLite (Raspberry Pi 5 deployment)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ──────────────────────────────────────────────
// Admin User
// ──────────────────────────────────────────────
model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ──────────────────────────────────────────────
// Global Settings (key-value store)
// ──────────────────────────────────────────────
model GlobalSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("global_settings")
}

// ──────────────────────────────────────────────
// Resource Type (user-defined unit categories)
// ──────────────────────────────────────────────
model ResourceType {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  icon            String  @default("Home")  // Lucide icon name
  sortOrder       Int     @default(0)

  // Default behavior for units in this category (for billing/long-term logic)
  defaultUnitType String  @default("CABIN")  // CABIN | SEASONAL | CARAVAN | PITCH

  // Link to external booking system resource type
  externalId       String?
  externalProvider String?

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resource_types")
}

// ──────────────────────────────────────────────
// Unit (Hytte, Campingvogn, Plads, etc.)
// ──────────────────────────────────────────────
enum UnitType {
  CABIN         // Hytte (korttid)
  SEASONAL      // Fastligger (langtidsleje)
  CARAVAN       // Campingvogn (korttid)
  PITCH         // Plads (korttid)
}

enum UnitStatus {
  VACANT
  OCCUPIED
}

model Unit {
  id       Int        @id @default(autoincrement())
  name     String
  type     UnitType   @default(CABIN)
  status   UnitStatus @default(VACANT)

  // For langtidsleje (SEASONAL): gæstens info og portal
  isLongTerm       Boolean  @default(false)
  longTermGuestName    String?
  longTermGuestEmail   String?
  longTermGuestPhone   String?
  longTermPortalToken  String?  @unique // Permanent gæsteportal for langtidslejere

  // External booking system (Danplanner etc.)
  externalId       String?
  externalProvider String?

  // Site map position (percentage 0-100 of map image dimensions)
  mapX             Float?
  mapY             Float?

  // User-defined resource type (replaces enum-based type for grouping/display)
  resourceTypeId   Int?
  resourceType     ResourceType? @relation(fields: [resourceTypeId], references: [id], onDelete: SetNull)

  // Manual ordering on dashboard within resource type
  sortOrder        Int @default(0)

  hardware         UnitHardware?
  sessions         Session[]
  invoices         Invoice[]
  consumptionLogs  ConsumptionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

// ──────────────────────────────────────────────
// Unit Hardware Configuration (1-to-1 with Unit)
// ──────────────────────────────────────────────
model UnitHardware {
  id     Int  @id @default(autoincrement())
  unitId Int  @unique
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Electricity — main power relay + meter
  // `electricitySource` picks the transport: "HA" (Home Assistant REST API)
  // or "MQTT" (direct to mosquitto broker). The fields used for each source
  // are independent — users can configure both and switch between them.
  hasElectricity            Boolean @default(false)
  electricitySource         String  @default("HA")  // "HA" | "MQTT"
  electricitySwitchEntityId String?   // HA: Relay entity (e.g. switch.hytte1_el)
  electricityMeterEntityId  String?   // HA: Energy sensor entity (kWh)
  electricityPowerEntityId  String?   // HA: Power sensor entity (W)
  // MQTT: One Shelly Gen2/3+ component covers switch + meter + power.
  // Example: prefix=shellyplus1pm-abc123, component=switch:0
  // Status topic:  {prefix}/status/{component}  (retained JSON)
  // Command topic: {prefix}/command/{component} (payload: "on"/"off")
  electricityMqttPrefix     String?
  electricityMqttComponent  String?

  // Heating — separate relay for electric radiators (no wifi thermostat)
  hasHeating             Boolean @default(false)
  heatingSource          String  @default("HA")  // "HA" | "MQTT"
  heatingSwitchEntityId  String?   // HA: Relay entity
  heatingMeterEntityId   String?   // HA: Optional separate energy sensor (kWh)
  heatingPowerEntityId   String?   // HA: Optional power sensor (W)
  heatingMqttPrefix      String?
  heatingMqttComponent   String?
  winterModeEnabled      Boolean @default(false)  // Keep heating on when vacant (protect cabin)

  // Water (LoRaWAN meter or Shelly pulse counter)
  hasWater           Boolean @default(false)
  waterSource        String  @default("HA")  // "HA" | "MQTT"
  waterMeterEntityId String?
  waterMqttPrefix    String?
  waterMqttComponent String?   // e.g. switch:0 if behind a Shelly 1PM reading liters

  // Climate (wifi thermostat / heat pump — different from dumb radiator relay)
  // HA only — Shelly does not cover climate control natively.
  hasClimate      Boolean @default(false)
  climateEntityId String?

  // Smart Lock — HA only (Shelly does not cover smart locks natively)
  hasSmartLock  Boolean @default(false)
  lockEntityId  String?

  @@map("unit_hardware")
}

// ──────────────────────────────────────────────
// Guest Session (a single stay or billing period)
// ──────────────────────────────────────────────
enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Session {
  id     Int  @id @default(autoincrement())
  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  guestName        String
  guestEmail       String?
  guestPhone       String?
  bookingRef       String?           // Booking-nummer
  guestPortalToken String        @unique
  status           SessionStatus @default(ACTIVE)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentId        String?           // QuickPay transaction ID
  paidAt           DateTime?

  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  expectedCheckOut DateTime?  // Optional planned checkout date

  // Billing mode: POSTPAID = pay at checkout, PREPAID = paid upfront in DKK
  billingMode    String  @default("POSTPAID")  // "PREPAID" or "POSTPAID"
  prepaidAmount  Float?  // DKK amount paid upfront (for PREPAID mode)

  // Baseline readings captured from HA
  startKwh         Float?
  startHeatingKwh  Float?
  startWaterLiters Float?

  // End readings captured at check-out / period close
  endKwh         Float?
  endHeatingKwh  Float?
  endWaterLiters Float?

  // Calculated totals
  totalElectricityCost Float?
  totalWaterCost       Float?
  totalCost            Float?

  // Per-booking price overrides (DKK). Admin can override the global rates
  // when manually editing a booking — e.g. to charge a flat rate agreed
  // with the guest, independent of the pricing_mode setting.
  pricePerKwhOverride     Float?
  pricePerLiterWaterOverride Float?

  // Time-weighted billing accumulators. Updated by tickSessionConsumption
  // (cron every 10 min) — each tick reads the meter, computes the delta
  // since the last tick, and adds `delta × current hourly spot price` to
  // accumulatedElCost. This way the guest is billed against the actual
  // spot price in the hour the kWh was consumed, not a single snapshot.
  accumulatedElCost       Float     @default(0)
  accumulatedElKwh        Float     @default(0)
  accumulatedWaterCost    Float     @default(0)
  accumulatedWaterLiters  Float     @default(0)
  lastTickKwh             Float?
  lastTickHeatingKwh      Float?
  lastTickWaterLiters     Float?
  lastTickAt              DateTime?

  // External booking system price (added to total)
  externalPrice       Float?
  externalDescription String?

  // Laundry credit (admin can add credit for guests who paid at register)
  laundryCredit  Float   @default(0)

  notes String?   // Admin-bemærkninger

  // Accounting system sync
  accountingSyncId String?
  accountingSyncAt DateTime?

  laundrySessions LaundrySess[]
  showerSessions  ShowerSess[]
  prepaidTopUps   PrepaidTopUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])              // tickAllSessionConsumption, admin dashboards
  @@index([unitId, status])      // getActiveSessionForUnit, getLiveConsumption
  @@index([status, billingMode]) // checkPrepaidBalances
  @@map("sessions")
}

// ──────────────────────────────────────────────
// Invoice (monthly billing for long-term renters)
// ──────────────────────────────────────────────
enum InvoiceStatus {
  DRAFT       // Kladde — endnu ikke sendt
  PENDING     // Afventer betaling
  PAID        // Betalt
  OVERDUE     // Forfalden
}

model Invoice {
  id     Int  @id @default(autoincrement())
  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Billing period
  periodStart DateTime
  periodEnd   DateTime

  // Meter readings for this period
  startKwh         Float?
  endKwh           Float?
  startHeatingKwh  Float?
  endHeatingKwh    Float?
  startWaterLiters Float?
  endWaterLiters   Float?

  // Costs
  electricityCost Float  @default(0)
  waterCost       Float  @default(0)
  totalAmount     Float  @default(0)

  status    InvoiceStatus @default(DRAFT)
  paidAt    DateTime?
  paymentId String?       // QuickPay transaction ID

  // Payment link
  paymentToken String? @unique // UUID for payment page

  // Accounting system sync
  accountingSyncId String?   // External invoice number from e-conomic etc.
  accountingSyncAt DateTime? // When it was last synced

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId, periodStart]) // getSessionStatement, monthly invoice lookup
  @@index([status])              // checkOverdueInvoices
  @@map("invoices")
}

// ──────────────────────────────────────────────
// Consumption Log (periodic readings for trends)
// ──────────────────────────────────────────────
model ConsumptionLog {
  id     Int  @id @default(autoincrement())
  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  electricityKwh Float?
  waterLiters    Float?

  recordedAt DateTime @default(now())

  @@index([unitId, recordedAt]) // charts + checkConsumptionAlarms
  @@map("consumption_logs")
}

// ──────────────────────────────────────────────
// Spot Price Cache (EDS electricity prices)
// ──────────────────────────────────────────────
model SpotPriceCache {
  id          Int      @id @default(autoincrement())
  area        String                 // "DK1" or "DK2"
  hourDK      String                 // "2026-04-05T14:00:00" (Danish local time)
  priceDKK    Float                  // DKK per MWh (raw from API)
  priceEUR    Float   @default(0)    // EUR per MWh
  fetchedAt   DateTime @default(now()) // When this record was fetched from API

  @@unique([area, hourDK])
  @@map("spot_price_cache")
}

// ──────────────────────────────────────────────
// Laundry Machine (shared facility with Shelly relay)
// ──────────────────────────────────────────────
model LaundryMachine {
  id               Int     @id @default(autoincrement())
  name             String                           // "Vaskemaskine 1", "Tørretumbler"
  kind             String  @default("WASHER")       // WASHER | DRYER
  // Hardware transport: "HA" uses switchEntityId against Home Assistant,
  // "MQTT" uses mqttPrefix+mqttComponent against the Mosquitto broker.
  source           String  @default("HA")           // "HA" | "MQTT"
  switchEntityId   String?                          // HA switch entity to control
  mqttPrefix       String?                          // e.g. shellyplus1pm-abc123
  mqttComponent    String?                          // e.g. switch:0
  durationMinutes  Int     @default(60)             // How long it runs per use
  pricePerUse      Float   @default(25)             // DKK per use
  enabled          Boolean @default(true)           // Admin can disable
  code             String? @unique                  // 4-digit quick-select code (washers 2xxx, dryers 3xxx)
  location         String?                          // Free-form location label ("Bygning A", "Vaskerum 2")

  // Metered billing: charge per-minute based on actual power consumption
  billingMode        String  @default("FIXED")      // FIXED | METERED
  pricePerMinute     Float   @default(1)            // DKK per minute (metered)
  powerThresholdW    Float   @default(10)           // Watts above which machine is "active"
  idleTimeoutMinutes Int     @default(5)            // Minutes below threshold → done
  maxReservationDKK  Float   @default(150)          // Pre-auth reservation amount
  powerEntityId      String?                        // HA power sensor entity (MQTT uses same component)

  groupId          Int?
  group            LaundryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  programs LaundryProgram[]
  sessions LaundrySess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("laundry_machines")
}

// ──────────────────────────────────────────────
// Laundry Program (e.g. Hurtig vask 60min, Standard 140min, Kogevask 180min)
// ──────────────────────────────────────────────
model LaundryProgram {
  id              Int     @id @default(autoincrement())
  machineId       Int
  machine         LaundryMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name            String                            // "Hurtig vask", "Standard", "Kogevask"
  durationMinutes Int                               // Relay on for this many minutes
  pricePerUse     Float                             // DKK
  sortOrder       Int     @default(0)
  enabled         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId, sortOrder])
  @@map("laundry_programs")
}

// ──────────────────────────────────────────────
// Shower (shared facility with Shelly valve relay)
// ──────────────────────────────────────────────
model Shower {
  id               Int     @id @default(autoincrement())
  name             String                           // "Bad 1"
  // Hardware transport: "HA" uses switchEntityId against Home Assistant,
  // "MQTT" uses mqttPrefix+mqttComponent against the Mosquitto broker.
  source           String  @default("HA")           // "HA" | "MQTT"
  switchEntityId   String?                          // HA relay for the valve
  mqttPrefix       String?                          // e.g. shellyplus1pm-abc123
  mqttComponent    String?                          // e.g. switch:0
  pricePerMinute   Float   @default(2)              // DKK per minute
  minMinutes       Int     @default(2)
  maxMinutes       Int     @default(30)
  enabled          Boolean @default(true)
  code             String? @unique                  // 4-digit quick-select code (showers 1xxx)
  location         String?                          // Free-form location label

  sessions ShowerSess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("showers")
}

// ──────────────────────────────────────────────
// Shower Session (active buy with pause support)
// ──────────────────────────────────────────────
model ShowerSess {
  id              Int      @id @default(autoincrement())
  accessToken     String   @unique @default(cuid())     // Secret URL token — prevents session hijacking
  showerId        Int
  shower          Shower   @relation(fields: [showerId], references: [id], onDelete: Cascade)

  // Optional link to guest session (null for day guests)
  sessionId       Int?
  session         Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  startedAt       DateTime @default(now())
  endsAt          DateTime                          // When the shower will auto-close (adjusted on pause/extend)
  status          String   @default("PENDING")      // PENDING | ACTIVE | PAUSED | COMPLETED | CANCELLED

  // Pause state
  pausedAt        DateTime?                         // When the current pause started
  pauseRemainingMs Int?                             // Remaining ms left when pause started
  pauseResumedAt  DateTime?                         // Last resume — enforces 10s pause cooldown

  pricePaid       Float    @default(0)              // Running total (extensions add to this)
  minutesPaid     Int      @default(0)              // Running total minutes paid (extensions add to this)
  paymentStatus   String   @default("UNPAID")       // UNPAID | PAID
  paymentId       String?                           // QuickPay transaction ID for current purchase
  pendingMinutes  Int?                              // Minutes being bought while waiting for callback (extension)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showerId, status])
  @@index([status, endsAt])
  @@map("shower_sessions")
}

// ──────────────────────────────────────────────
// Laundry Group (QR code grouping of machines)
// ──────────────────────────────────────────────
model LaundryGroup {
  id       Int     @id @default(autoincrement())
  name     String                           // "Vaskerum 1", "Bygning A"
  token    String  @unique                  // URL-safe token for public access
  machines LaundryMachine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("laundry_groups")
}

// ──────────────────────────────────────────────
// Laundry Session (one wash/dry cycle)
// ──────────────────────────────────────────────
model LaundrySess {
  id              Int      @id @default(autoincrement())
  machineId       Int
  machine         LaundryMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  // Optional: which program the guest picked. Snapshot of name/duration is kept
  // on the session itself so program edits/deletions don't break history.
  programId       Int?
  programName     String?                          // Snapshot of program name at start

  // Link to guest session (who started it)
  sessionId       Int?
  session         Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  guestPortalToken String?  // To identify the guest if session is null

  accessToken     String?  @unique                   // Secret URL token for metered session page

  startedAt       DateTime @default(now())
  endsAt          DateTime                         // When the machine should turn off
  status          String   @default("ACTIVE")      // ACTIVE, COMPLETED, CANCELLED
  durationMinutes Int      @default(0)             // Snapshot of duration at start
  pricePaid       Float    @default(0)
  paymentStatus   String   @default("UNPAID")      // UNPAID, PAID
  paymentId       String?                           // QuickPay transaction ID

  // Metered billing fields
  billingMode      String    @default("FIXED")       // FIXED | METERED
  pricePerMinute   Float?                            // Snapshot of rate
  reservedAmount   Float?                            // Pre-authorized amount
  meterStartedAt   DateTime?                         // When billing timer started (power > threshold)
  meterEndedAt     DateTime?                         // When billing timer ended (idle timeout)
  billedMinutes    Float     @default(0)             // Accumulated billable minutes
  lastPowerW       Float?                            // Last measured power in watts
  lastPowerAt      DateTime?                         // When last power was measured
  idleSince        DateTime?                         // When power first dropped below threshold

  createdAt DateTime @default(now())

  @@index([status, billingMode])
  @@map("laundry_sessions")
}

// ──────────────────────────────────────────────
// Prepaid Top-Up (idempotent payment processing)
// ──────────────────────────────────────────────
model PrepaidTopUp {
  id           Int      @id @default(autoincrement())
  sessionId    Int
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  paymentId    String   @unique                      // QuickPay transaction ID — ensures idempotency
  amount       Float                                 // DKK amount topped up
  appliedAt    DateTime @default(now())

  @@index([sessionId])
  @@map("prepaid_topups")
}
