# Database (SQLite via libsql)
DATABASE_URL="file:prisma/dev.db"

# Session encryption key (REQUIRED - generer med: openssl rand -base64 32)
SESSION_SECRET="change-this-to-a-random-32-character-string!!"

# Force HTTPS redirect (set to "true" for production behind reverse proxy)
# FORCE_HTTPS="true"

# Log directory (default: ./logs)
# LOG_DIR="/var/log/campsense"
